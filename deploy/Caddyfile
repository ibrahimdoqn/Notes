# Cam Notlar ön sunucusu. Erişim türü init.sh ile seçilir ve .env üzerinden buraya gelir:
#
#   yerel HTTPS : SITE_ADDRESS="https://192.168.1.1"  SITE_TLS="tls internal"  (Caddy'nin kendi kök sertifikası)
#   HTTP        : SITE_ADDRESS="http://"              SITE_TLS=""
#   internet    : SITE_ADDRESS="notlar.ornek.com"     SITE_TLS=""             (Let's Encrypt)
#
# Konteyner içinde HTTPS 443'te, HTTP 80'de dinler; dışarıdaki port docker-compose.yml'de eşlenir.
# {$...} değerleri Caddyfile okunmadan önce metin olarak yerine konur (birden çok sözcük olabilir).
{
	{$CADDY_GLOBAL}
}

{$SITE_ADDRESS:https://localhost} {
	{$SITE_TLS}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}

	handle /v1/* {
		# Ek yüklemeleri için gövde sınırı (MAX_ATTACHMENT_MB'den biraz büyük).
		request_body {
			max_size 64MB
		}
		reverse_proxy api:3000
	}
	handle /healthz {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@nocache path /sw.js /index.html /manifest.webmanifest / /yonetim/ /yonetim/index.html
		header @nocache Cache-Control "no-cache"
		try_files {path} {path}/index.html /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
