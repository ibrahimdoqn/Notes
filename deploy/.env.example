# init.sh bu dosyayı .env olarak kopyalar, soruları sorup değerleri doldurur.
# Elle düzenledikten sonra: docker compose up -d

# --- Erişim (init.sh doldurur) ---
# MODE: local-https | http | public
MODE=http
# Tarayıcıda/uygulamada yazılacak adres (ör. http://192.168.1.1:8080)
PUBLIC_URL=
# Dışarıdan bağlanılan port ve Caddy'nin konteyner içindeki portu (HTTP 80, HTTPS 443)
PORT=8080
INNER_PORT=80
SITE_ADDRESS=
SITE_TLS=
CADDY_GLOBAL=
# HTTP modunda false olmalı (çerez yalnızca HTTPS'te "Secure" olabilir)
SECURE_COOKIES=false

# --- Gizli değerler (init.sh üretir) ---
POSTGRES_PASSWORD=
# Ed25519 özel anahtarı (PKCS8 PEM, satır sonları \n ile)
JWT_PRIVATE_KEY=

# --- Diğer ---
# Dosya başına en büyük ek boyutu (MB)
MAX_ATTACHMENT_MB=25
# İnternete kapalı kurulumda sızdırılmış parola kontrolü (api.pwnedpasswords.com) kapatılabilir
HIBP_CHECK=true
TRASH_RETENTION_DAYS=30
BACKUP_HOUR=3
TZ=Europe/Istanbul
# Hazır imaj kullanmak için: IMAGE_PREFIX=ghcr.io/<kullanıcı> VERSION=1.0.0
IMAGE_PREFIX=ghcr.io/camnotlar
VERSION=local
