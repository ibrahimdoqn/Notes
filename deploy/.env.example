# init.sh bu dosyayı .env olarak kopyalar ve gizli değerleri üretir.
DOMAIN=notlar.ornek.com
ACME_EMAIL=
POSTGRES_PASSWORD=
# Ed25519 özel anahtarı (PKCS8 PEM, satır sonları \n ile)
JWT_PRIVATE_KEY=
ALLOW_SIGNUP=false
HIBP_CHECK=true
TRASH_RETENTION_DAYS=30
BACKUP_HOUR=3
TZ=Europe/Istanbul
# Hazır imaj kullanmak için: IMAGE_PREFIX=ghcr.io/<kullanıcı> VERSION=1.0.0
IMAGE_PREFIX=ghcr.io/camnotlar
VERSION=local
